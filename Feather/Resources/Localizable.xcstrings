          }
        }
      }
    },
    "تُوقَّع التطبيقات بالتتابع لتقليل الضغط على الذاكرة. تبقى معلومات كل تطبيق، وتطبّق خيارات التوقيع العامة والتخصيصات المسجلة له. يمكنك تثبيت كل نتيجة بعد اكتمالها." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُوقَّع التطبيقات بالتتابع لتقليل الضغط على الذاكرة. تبقى معلومات كل تطبيق، وتطبّق خيارات التوقيع العامة والتخصيصات المسجلة له. يمكنك تثبيت كل نتيجة بعد اكتمالها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps are signed in order to reduce memory use. Each app keeps its information and uses the shared signing options and its saved customizations. Install each result when it’s ready."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بەرنامەکان بە نۆرە واژۆ دەکرێن بۆ کەمکردنەوەی بەکارهێنانی بیرگە. زانیاری هەر بەرنامەیەک دەمێنێتەوە و هەڵبژاردە هاوبەشەکان و دەستکارییە تایبەتەکانی جێبەجێ دەکرێن. دەتوانیت هەر بەرنامەیەک کە ئامادە بوو دایبمەزرێنیت."
          }
        }
      }
    },
    "أضف مكتبة أو فريمورك، ثم راجع وجهة الحقن قبل التوقيع." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
