      }
    },
    "أوقف VPN أو البروكسي للمتابعة." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوقف VPN أو البروكسي للمتابعة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off VPN or proxy to continue."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بۆ بەردەوامبوون VPN یان پرۆکسی بکوژێنەوە."
          }
        }
      }
    },
    "عذراً، لا يمكن استخدام التطبيق أو التحميل أثناء تشغيل VPN أو مراقب شبكة." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عذراً، لا يمكن استخدام التطبيق أو التحميل أثناء تشغيل VPN أو مراقب شبكة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app and downloads are unavailable while a VPN or network monitor is active."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کاتێک VPN یان چاودێری تۆڕ چالاکە، بەرنامە و داگرتن بەردەست نین."
          }
        }
      }
    },
    "عذراً، لا يمكن استخدام تطبيق X-Sign أو تحميل التطبيقات أثناء تشغيل VPN أو برامج مراقبة الشبكة (Proxy)." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عذراً، لا يمكن استخدام تطبيق X-Sign أو تحميل التطبيقات أثناء تشغيل VPN أو برامج مراقبة الشبكة (Proxy)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off VPN or proxy to use XSign and download apps."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بۆ بەکارهێنانی XSign و داگرتنی بەرنامەکان VPN یان پرۆکسی بکوژێنەوە."
          }
        }
      }
    },
    "تعذّر التحقق من أمان الاتصال بسبب تشغيل VPN أو بروكسي. أوقفه ثم أعد المحاولة." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر التحقق من أمان الاتصال بسبب تشغيل VPN أو بروكسي. أوقفه ثم أعد المحاولة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection could not be verified while VPN or proxy is active. Turn it off and try again."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لە کاتی چالاکبوونی VPN یان پرۆکسی نەتوانرا سەلامەتی پەیوەندی بپشکنرێت. بیکوژێنەوە و دووبارە هەوڵ بدەوە."
          }
        }
      }
    },
    "أوقف iOS وقت العمل في الخلفية. افتح XSign وأعد محاولة التثبيت." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوقف iOS وقت العمل في الخلفية. افتح XSign وأعد محاولة التثبيت."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS stopped the background task. Open XSign and try installing again."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS کارەکەی لە پاشبنەما ڕاگرت. XSign بکەرەوە و دووبارە هەوڵی دامەزراندن بدەوە."
          }
        }
      }
    },
    "نقوم حالياً بتحديث الخدمات، يرجى المحاولة لاحقاً." : {
      "extractionState" : "manual",
