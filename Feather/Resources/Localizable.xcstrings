        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بە شێوەی بنەڕەتی ناوە وەرگێڕدراوەکانی بەرنامە ناگۆڕدرێن. ئەم هەڵبژاردنە ئەوانیش دەگۆڕێت."
