            "value" : "قُفل تغيير الأيقونة. حدّث الصلاحيات أو استخدم إعادة تعيين قبل التوقيع."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icon changes are locked. Refresh permissions or reset before signing."
